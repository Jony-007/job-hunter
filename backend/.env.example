# ───────────────────────────────────────────────────────────────────────────
# JobHunter Environment Variables Configuration
# Copy this file to '.env' and populate the parameters below.
# ───────────────────────────────────────────────────────────────────────────

# Application Mode
ENV=development
PORT=8000

# Backend Secrets
JWT_SECRET=jobhunter-super-secret-key-123!
DATABASE_URL=postgresql://neondb_owner:YOUR_DATABASE_PASSWORD_HERE@ep-lingering-frost-aq86xl1u.c-8.us-east-1.aws.neon.tech/neondb?sslmode=require

# Frontend URL (Used for CORS and verification redirects)
FRONTEND_URL=http://localhost:5173

# ── Option A: Gmail SMTP Configuration (Recommended for Local Dev) ──
# Setup instructions:
# 1. Open your Google Account (myaccount.google.com).
# 2. Search for "App Passwords" (requires 2-Step Verification enabled).
# 3. Create a new app password named "JobHunter".
# 4. Copy the generated 16-character code and paste it below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_SENDER=your-email@gmail.com

# ── Option B: Transactional Email Providers ──
# For services like Brevo (formerly Sendinblue), SendGrid, or Resend:
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-brevo-login-email
# SMTP_PASSWORD=your-brevo-smtp-key
# SMTP_SENDER=registered-sender@yourdomain.com
